// Define a normal distribution with mean 175 and standard deviation 7
var d = Gaussian({mu: 175, sigma: 7});

// Sample from the distribution
var s = sample(d);
display("A single sample: " + s);

// Calculate the probability density of a specific value (PDF)
var p = Math.exp(d.score(175));
display("Probability density at mean (175): " + p);

// Generate multiple samples and calculate the empirical mean
var samples = repeat(1000, function() { return sample(d); });
var empiricalMean = listMean(samples);
display("Empirical mean of 1000 samples: " + empiricalMean);